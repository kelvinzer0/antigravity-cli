{
  "name": "@kelvinzero/antigravity-cli",
  "version": "1.2.0",
  "description": "Open-source community CLI for Antigravity - supports custom AI models (OpenAI, Anthropic, Ollama, OpenRouter, Google AI Studio) alongside Gemini, with agent-context injection so custom models behave like Antigravity agents",
  "homepage": "https://github.com/kelvinzer0/antigravity-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kelvinzer0/antigravity-cli.git"
  },
  "author": {
    "name": "Vahap Ogut",
    "email": "vahap.ogut@outlook.com"
  },
  "license": "Apache-2.0",
  "main": "dist/cli.js",
  "bin": {
    "antigravity": "./dist/cli.js",
    "antigravity-cli": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "npx tsc",
    "dev": "npx ts-node src/cli.ts",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build",
    "test": "jest"
  },
  "keywords": [
    "antigravity",
    "cli",
    "ai",
    "openai",
    "anthropic",
    "claude",
    "gemini",
    "ollama",
    "chatbot",
    "community",
    "open-source",
    "agent-context",
    "context-injection",
    "compaction",
    "reasoning-effort"
  ],
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "inquirer": "^8.2.6",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/inquirer": "^8.2.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.5.0"
  }
}
